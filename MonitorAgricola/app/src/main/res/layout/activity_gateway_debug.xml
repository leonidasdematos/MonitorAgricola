<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvGatewayDebugDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gateway_debug_description"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/tvGatewayConnectionState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="" />

    <TextView
        android:id="@+id/tvGatewayTelemetryState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="" />

    <com.example.monitoragricola.ui.GatewayImplementDebugView
        android:id="@+id/gatewayImplementDebugView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="#EEEEEE" />

    <TextView
        android:id="@+id/tvGatewayTelemetryRaw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:textSize="12sp" />

</LinearLayout>