<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGatewayInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_gateway_coordinates_info"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvGatewaySectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_gateway_section_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGatewayConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_gateway_connect_button" />

        <TextView
            android:id="@+id/tvGatewayDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_gateway_selected_device_default" />

        <TextView
            android:id="@+id/tvGatewayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_gateway_status_disconnected" />

    </LinearLayout>

</ScrollView>
