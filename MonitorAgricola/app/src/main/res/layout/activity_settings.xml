<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioGroup
            android:id="@+id/rgFonte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <RadioButton
                android:id="@+id/rbGps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS do Celular" />

            <RadioButton
                android:id="@+id/rbSimulador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simulação" />

            <RadioButton
                android:id="@+id/rbRtk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_source_gateway" />

        </RadioGroup>

        <TextView
            android:id="@+id/tvGatewaySectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_gateway_section_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGatewayConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_gateway_connect_button" />

        <TextView
            android:id="@+id/tvGatewayDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_gateway_selected_device_default" />

        <TextView
            android:id="@+id/tvGatewayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_gateway_status_disconnected" />

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</ScrollView>
